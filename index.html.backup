<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digiturk Bilgi Portalı</title>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#17102f">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <link rel="icon" type="image/svg+xml" href="/portal-icon.svg">

    <style>
        body > :not(#portal-root):not(script) { visibility: hidden; }
        body.portal-ready > :not(#portal-root):not(script) { visibility: visible; }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        header {
            background: rgba(255,255,255,0.95);
            padding: 18px 20px;
            text-align: center;
            font-size: 1.4rem;
            font-weight: bold;
            color: #6366f1;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-title {
            flex: 1;
        }

        .install-btn {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            border: none;
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            margin-left: 10px;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
        }

        .container {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: rgba(255,255,255,0.95);
            margin: 10px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .tabs {
            display: flex;
            background: #f8f9fa;
            border-radius: 20px 20px 0 0;
            overflow: hidden;
        }

        .tab {
            flex: 1;
            padding: 14px;
            text-align: center;
            cursor: pointer;
            font-weight: bold;
            color: #666;
            transition: all 0.3s;
            font-size: 14px;
        }

        .tab.active {
            color: #6366f1;
            background: white;
            border-bottom: 3px solid #6366f1;
        }

        .content {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: none;
        }

        .content.active {
            display: block;
        }

        .admin-area textarea {
            width: 100%;
            height: 180px;
            margin-bottom: 12px;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 14px;
            font-family: inherit;
        }

        .admin-area input,
        .admin-area select {
            width: 100%;
            padding: 12px;
            margin-bottom: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 15px;
            font-family: inherit;
        }

        .btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 14px;
            width: 100%;
            border-radius: 12px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
        }

        .status {
            font-size: 13px;
            color: #10b981;
            margin-top: 12px;
            text-align: center;
            display: none;
            padding: 10px;
            background: #d1fae5;
            border-radius: 8px;
        }

        #chatBox {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            background: #f8f9fa;
            display: flex;
            flex-direction: column;
        }

        .msg {
            margin-bottom: 12px;
            padding: 12px 16px;
            border-radius: 18px;
            max-width: 82%;
            word-wrap: break-word;
            animation: slideIn 0.3s ease-out;
            line-height: 1.5;
            font-size: 15px;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .user {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
        }

        .bot {
            background: white;
            color: #333;
            align-self: flex-start;
            border-bottom-left-radius: 4px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .input-area {
            display: flex;
            padding: 12px;
            background: white;
            border-top: 1px solid #e0e0e0;
            align-items: center;
            gap: 8px;
        }

        .input-area input {
            flex: 1;
            padding: 12px 18px;
            border: 2px solid #e0e0e0;
            border-radius: 25px;
            font-size: 15px;
            font-family: inherit;
        }

        .input-area button.send-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            font-size: 18px;
            flex-shrink: 0;
        }

        .mic-btn {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            font-size: 20px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
            flex-shrink: 0;
        }

        .mic-btn:active,
        .mic-btn.recording {
            transform: scale(0.92);
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.6);
            animation: pulse 1s infinite;
        }

        @keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
            }

            50% {
                box-shadow: 0 0 0 12px rgba(239, 68, 68, 0);
            }
        }

        h3 {
            color: #6366f1;
            margin-bottom: 8px;
            font-size: 1.1rem;
            margin-top: 12px;
        }

        h3:first-child {
            margin-top: 0;
        }

        p {
            color: #666;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .voice-status {
            text-align: center;
            padding: 8px;
            background: #fef3c7;
            color: #92400e;
            border-radius: 8px;
            margin-bottom: 10px;
            font-size: 13px;
            display: none;
        }

        .voice-status.active {
            display: block;
        }

        .voice-indicator {
            display: inline-block;
            width: 8px;
            height: 8px;
            background: #ef4444;
            border-radius: 50%;
            margin-right: 6px;
            animation: blink 1s infinite;
        }

        @keyframes blink {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.3;
            }
        }

        .speaking-indicator {
            text-align: center;
            padding: 6px;
            background: #dbeafe;
            color: #1e40af;
            border-radius: 8px;
            margin-bottom: 8px;
            font-size: 12px;
            display: none;
        }

        .speaking-indicator.active {
            display: block;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.6);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background: white;
            border-radius: 20px;
            padding: 25px;
            max-width: 340px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }

        .modal h2 {
            color: #6366f1;
            margin-bottom: 15px;
            font-size: 1.3rem;
        }

        .modal p {
            color: #555;
            margin-bottom: 12px;
            font-size: 14px;
            line-height: 1.5;
        }

        .modal ol {
            color: #555;
            margin-bottom: 15px;
            padding-left: 25px;
            font-size: 14px;
            line-height: 1.8;
        }

        .modal button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px;
            width: 100%;
            border-radius: 12px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            margin-bottom: 8px;
        }

        .modal .close-btn {
            background: #e5e7eb;
            color: #333;
        }

        .setting-row {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
        }

        .setting-row > * {
            flex: 1;
        }

        label {
            font-size: 13px;
            color: #555;
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
        }
    </style>
</head>

<body>

<header>
    <div class="header-title">🤖 AI Bilgi Asistanı</div>
    <button class="install-btn" id="installBtn" style="display:none;">📥 Yükle</button>
</header>

<div class="container">

    <div class="tabs">
        <button type="button" class="tab active" onclick="openTab(event, 'chat')">
            💬 Sohbet
        </button>

        <button type="button" class="tab" onclick="openTab(event, 'admin')">
            ⚙️ Ses Ayarları
        </button>
    </div>

    <div id="chat" class="content active">

        <div id="voiceStatus" class="voice-status">
            <span class="voice-indicator"></span>
            🎤 Dinliyorum... Konuş!
        </div>

        <div id="chatBox"></div>

    </div>

    <div id="admin" class="content admin-area">

        <h3>🎤 Ses Ayarları</h3>

        <div class="setting-row">

            <div>
                <label>Cevap Sesi:</label>

                <select id="voiceGender">
                    <option value="female">👩 Kadın</option>
                    <option value="male">👨 Erkek</option>
                </select>
            </div>

            <div>
                <label>Hız:</label>

                <select id="voiceRate">
                    <option value="0.85">Yavaş</option>
                    <option value="1.0" selected>Normal</option>
                    <option value="1.15">Hızlı</option>
                </select>
            </div>

        </div>

        <button class="btn" onclick="saveData()">
            💾 Verileri Kaydet
        </button>

        <div id="statusMsg" class="status">
            ✅ Kaydedildi!
        </div>

    </div>

</div>

<!-- SESLİ KOMUT / GÖNDERME ALANI -->

<div class="input-area">

    <input
        type="text"
        id="userInput"
        placeholder="Ne merak ediyorsun?"
        aria-label="Ne merak ediyorsun?"
        onkeypress="if(event.key === 'Enter') sendMessage()"
    >

    <button class="mic-btn" id="micBtn" type="button" aria-label="Sesli soru sor">🎤</button>

    <button
        class="send-btn"
        aria-label="Soruyu gönder"
        onclick="sendMessage()"
    >
        ➤
    </button>

</div>

<!-- Yükleme Modal -->

<div class="modal-overlay" id="installModal">

    <div class="modal">

        <h2>📱 Uygulamayı Yükle</h2>

        <p id="installText">
            Uygulamayı ana ekranına eklemek için:
        </p>

        <ol id="installSteps">
            <li>
                Sağ üstteki <b>⋮</b> menüsüne tıkla
            </li>

            <li>
                <b>"Ana ekrana ekle"</b> veya
                <b>"Uygulamayı yükle"</b> seç
            </li>

            <li>
                <b>"Ekle"</b> butonuna bas
            </li>
        </ol>

        <button onclick="closeInstallModal()">
            Anladım
        </button>

        <button
            class="close-btn"
            onclick="closeInstallModal()"
        >
            Kapat
        </button>

    </div>

</div>

<script>

    /* =========================================
       PWA YÜKLEME DESTEĞİ
    ========================================= */

    let deferredPrompt;

    const installBtn =
        document.getElementById('installBtn');

    const installModal =
        document.getElementById('installModal');

    window.addEventListener(
        'beforeinstallprompt',
        (e) => {

            e.preventDefault();

            deferredPrompt = e;

            installBtn.style.display = 'block';

        }
    );

    installBtn.addEventListener(
        'click',
        async () => {

            if (deferredPrompt) {

                deferredPrompt.prompt();

                const { outcome } =
                    await deferredPrompt.userChoice;

                if (outcome === 'accepted') {
                    installBtn.style.display = 'none';
                }

                deferredPrompt = null;

            } else {

                showInstallModal();

            }

        }
    );

    function showInstallModal() {

        const isIOS =
            /iPad|iPhone|iPod/.test(
                navigator.userAgent
            );

        const steps =
            document.getElementById(
                'installSteps'
            );

        const text =
            document.getElementById(
                'installText'
            );

        if (isIOS) {

            text.innerText =
                'iPhone/iPad\'da uygulamayı yüklemek için:';

            steps.innerHTML = `
                <li>
                    Alt ortadaki <b>Paylaş</b> butonuna tıkla
                </li>

                <li>
                    Aşağı kaydır ve
                    <b>"Ana Ekrana Ekle"</b> seç
                </li>

                <li>
                    Sağ üstten <b>"Ekle"</b> de
                </li>
            `;

        } else {

            text.innerText =
                'Android\'de uygulamayı yüklemek için:';

            steps.innerHTML = `
                <li>
                    Sağ üstteki <b>⋮</b> menüsüne tıkla
                </li>

                <li>
                    <b>"Ana ekrana ekle"</b> veya
                    <b>"Uygulamayı yükle"</b> seç
                </li>

                <li>
                    <b>"Ekle"</b> butonuna bas
                </li>
            `;

        }

        installModal.classList.add('active');
    }

    function closeInstallModal() {

        installModal.classList.remove('active');

    }


    /* =========================================
       SAYFA YÜKLENDİĞİNDE
    ========================================= */

    window.onload = () => {

        localStorage.removeItem('apiKey');

        document.getElementById('voiceGender').value =
            localStorage.getItem('voiceGender') || 'female';

        document.getElementById('voiceRate').value =
            localStorage.getItem('voiceRate') || '1.0';

        addMessage(
            "Merhaba! 👋 Sana nasıl yardımcı olabilirim? Sesli veya yazılı soru sorabilirsin.",
            'bot'
        );

    };


    /* =========================================
       SEKME DEĞİŞTİRME
    ========================================= */

    function openTab(evt, tabName) {

        const contents =
            document.getElementsByClassName(
                "content"
            );

        for (
            let i = 0;
            i < contents.length;
            i++
        ) {

            contents[i].classList.remove(
                "active"
            );

        }

        const tabs =
            document.getElementsByClassName(
                "tab"
            );

        for (
            let i = 0;
            i < tabs.length;
            i++
        ) {

            tabs[i].classList.remove(
                "active"
            );

        }

        document
            .getElementById(tabName)
            .classList.add("active");

        evt.currentTarget.classList.add(
            "active"
        );

    }


    /* =========================================
       VERİLERİ KAYDET
    ========================================= */

    function saveData() {

        const gender =
            document.getElementById(
                'voiceGender'
            ).value;

        const rate =
            document.getElementById(
                'voiceRate'
            ).value;

        localStorage.setItem(
            'voiceGender',
            gender
        );

        localStorage.setItem(
            'voiceRate',
            rate
        );

        const status =
            document.getElementById(
                'statusMsg'
            );

        status.style.display = 'block';

        setTimeout(() => {

            status.style.display = 'none';

        }, 2500);

    }


    /* =========================================
       MESAJ EKLE
    ========================================= */

    function addMessage(text, sender) {

        const chatBox =
            document.getElementById(
                'chatBox'
            );

        const msgDiv =
            document.createElement(
                'div'
            );

        msgDiv.className =
            `msg ${sender}`;

        msgDiv.innerText =
            text;

        chatBox.appendChild(
            msgDiv
        );

        chatBox.scrollTop =
            chatBox.scrollHeight;

    }


    /* =========================================
       SES TANIMA / MİKROFON
    ========================================= */

    const micBtn =
        document.getElementById(
            'micBtn'
        );

    const voiceStatus =
        document.getElementById(
            'voiceStatus'
        );

    const userInput =
        document.getElementById(
            'userInput'
        );

    let recognition = null;

    let isRecording = false;

    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;


    if (SpeechRecognition) {

        recognition =
            new SpeechRecognition();

        recognition.lang =
            'tr-TR';

        recognition.continuous =
            false;

        recognition.interimResults =
            false;

        recognition.maxAlternatives =
            1;


        recognition.onresult =
            (event) => {

                const transcript =
                    event
                        .results[0][0]
                        .transcript;

                userInput.value =
                    transcript;

                window.dispatchEvent(new Event('portal-voice-question'));
                stopRecording();

                setTimeout(
                    () => sendMessage(),
                    400
                );

            };


        recognition.onerror =
            (event) => {

                console.error(
                    'Ses hatası:',
                    event.error
                );

                stopRecording();

                if (
                    event.error ===
                    'not-allowed'
                ) {

                    addMessage(
                        "⚠️ Mikrofon izni verilmedi. Tarayıcı ayarlarından mikrofon izni ver.",
                        'bot'
                    );

                } else if (
                    event.error ===
                    'no-speech'
                ) {

                    addMessage(
                        "🎤 Ses algılanamadı, tekrar dene.",
                        'bot'
                    );

                }

            };


        recognition.onend =
            () => {

                stopRecording();

            };

    } else {

        micBtn.style.display =
            'none';

    }


    /* =========================================
       KAYDI BAŞLAT
    ========================================= */

    function startRecording() {

        if (!recognition) {

            addMessage(
                "⚠️ Tarayıcın ses tanımayı desteklemiyor. Chrome kullan.",
                'bot'
            );

            return;

        }

        if (isRecording)
            return;


        try {

            recognition.start();

            isRecording =
                true;

            micBtn.classList.add(
                'recording'
            );

            voiceStatus.classList.add(
                'active'
            );

        } catch (e) {

            console.error(
                'Başlatma hatası:',
                e
            );

        }

    }


    /* =========================================
       KAYDI DURDUR
    ========================================= */

    function stopRecording() {

        if (!isRecording)
            return;

        isRecording =
            false;

        micBtn.classList.remove(
            'recording'
        );

        voiceStatus.classList.remove(
            'active'
        );

        try {

            recognition.stop();

        } catch (e) {}

    }


    /* =========================================
       TELEFON DOKUNMATİK
       BASILI TUT → KONUŞ
       BIRAK → DUR
    ========================================= */

    micBtn.addEventListener(
        'touchstart',
        (e) => {

            e.preventDefault();

            startRecording();

        }
    );

    micBtn.addEventListener(
        'touchend',
        (e) => {

            e.preventDefault();

            stopRecording();

        }
    );

    micBtn.addEventListener(
        'touchcancel',
        (e) => {

            e.preventDefault();

            stopRecording();

        }
    );


    /* =========================================
       BİLGİSAYAR / MOUSE
    ========================================= */

    micBtn.addEventListener(
        'mousedown',
        startRecording
    );

    micBtn.addEventListener(
        'mouseup',
        stopRecording
    );

    micBtn.addEventListener(
        'mouseleave',
        stopRecording
    );


    /* =========================================
       AI MESAJ GÖNDERME
    ========================================= */

    async function sendMessage() {

        const userText =
            userInput.value.trim();

        if (!userText)
            return;


        addMessage(
            userText,
            'user'
        );

        userInput.value =
            '';


        /* =====================================
           BİLGİ MERKEZİ KURALLARI
        ===================================== */

        try {

            addMessage(
                "Düşünüyorum...",
                'bot'
            );

            const loadingMsg =
                document.querySelector(
                    '.msg.bot:last-child'
                );


            /* =================================
               OPENAI API
            ================================= */

            const response =
                await fetch(
                    '/api/chat',
                    {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ question: userText })

                    }
                );


            const data =
                await response.json();


            if (loadingMsg)
                loadingMsg.remove();


            if (data.error) {

                addMessage(
                    "Hata: " +
                    data.error.message,
                    'bot'
                );

            } else {

                const aiResponse =
                    data
                        .choices[0]
                        .message
                        .content;


                addMessage(
                    aiResponse,
                    'bot'
                );



            }


        } catch (error) {

            document
                .querySelector(
                    '.msg.bot:last-child'
                )
                ?.remove();


            console.error(
                'Bağlantı hatası:',
                error
            );


            addMessage(
                "⚠️ Bağlantı hatası oluştu.",
                'bot'
            );

        }

    }

</script>


<script>

    /* =========================================
       SERVICE WORKER
    ========================================= */

    if (
        'serviceWorker' in navigator
    ) {

        navigator.serviceWorker
            .register('sw.js')
            .catch(
                error => {

                    console.log(
                        'Service Worker hatası:',
                        error
                    );

                }
            );

    }

</script>

<script type="module" src="/src/portal.ts"></script>
</body>
</html>